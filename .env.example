# Database
DB_USER=modeltech_user
DB_PASSWORD=change_me_secret
DB_URL=jdbc:postgresql://db:5432/modeltech_hub

# MinIO
MINIO_ROOT_USER=admin_minio
MINIO_ROOT_PASSWORD=minio_password
MINIO_BUCKET=media

# JWT
JWT_SECRET=generer_une_longue_chaine_aleatoire_ici
JWT_EXPIRATION=86400000

# Hors production uniquement : redirige TOUS les e-mails vers cette adresse de recette
# MAIL_REDIRECT_TO=recette@example.com
# Trace SMTP complete (affiche les identifiants) : depannage local seulement
# MAIL_SMTP_DEBUG=false

# Connexion Google (ID client OAuth Web ; vide = desactivee)
GOOGLE_CLIENT_ID=

# ── Paiement en ligne du simulateur (PayDunya) ───────────────────────────────
# Vides = achat en ligne désactivé (aucun bouton « Acheter », la liste d'attente reste disponible).
# Les 3 clés doivent être du MÊME mode que PAYDUNYA_MODE : clés de TEST avec « sandbox » (aucun argent réel),
# clés de PRODUCTION avec « live » (après le KYC). Ne jamais committer les valeurs.
PAYDUNYA_MODE=sandbox
PAYDUNYA_MASTER_KEY=
PAYDUNYA_PRIVATE_KEY=
PAYDUNYA_TOKEN=
PAYDUNYA_STORE_NAME=Model Technologie
# Adresse de notification (IPN) à déclarer chez PayDunya ET ici. Cloudflare ne doit pas bloquer ce POST.
PAYDUNYA_CALLBACK_URL=https://api.model-technologie.com/api/v1/payments/paydunya/ipn
# Frais du prestataire de paiement. ABSORB (défaut) : les prix du catalogue les absorbent, le client paie le prix affiché.
# PASS_ON : le client paie le prix + les frais, uniquement en paiement en ligne (le manuel reste au prix du catalogue).
# Renseigner le taux et la part fixe selon la grille PayDunya de votre compte. Aucune modification de code nécessaire.
PAYMENTS_FEES_MODE=ABSORB
PAYMENTS_FEES_PERCENT=0
PAYMENTS_FEES_FIXED_XOF=0
