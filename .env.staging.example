# ─────────────────────────────────────────────────────────────────────────────
# Variables du STAGING (Dokploy > Environnement du compose docker-compose.staging.yml)
# Modèle sans secret : ne jamais committer les valeurs réelles.
# ─────────────────────────────────────────────────────────────────────────────

# Profil Spring (staging = Swagger actif, logs applicatifs en DEBUG)
SPRING_PROFILES_ACTIVE=staging

# ── Base de données ──────────────────────────────────────────────────────────
DB_USER=modeltech_staging
DB_PASSWORD=<mot de passe long et aléatoire>
DB_NAME=modeltech_staging

# ── Sécurité ─────────────────────────────────────────────────────────────────
# 64 octets minimum, sinon aucune connexion ne fonctionne :  openssl rand -base64 64
JWT_SECRET=<chaine aleatoire de 64 octets ou plus>
# Origine(s) du front staging, séparées par des virgules, sans slash final
CORS_ALLOWED_ORIGINS=https://staging.model-technologie.com
# URL publique du front staging : base des liens des e-mails (paiement, mot de passe, certificat, connexion)
APP_FRONTEND_URL=https://staging.model-technologie.com
# Clé SECRÈTE reCAPTCHA v3 correspondant à la clé de site du front (le domaine staging doit être autorisé chez Google)
RECAPTCHA_SECRET_KEY=<clé secrète>
# Connexion Google : ID client OAuth Web ; « Origines JavaScript autorisées » = URL du front staging. Vide = bouton masqué.
GOOGLE_CLIENT_ID=

# ── Stockage MinIO ───────────────────────────────────────────────────────────
MINIO_ROOT_USER=<utilisateur>
MINIO_ROOT_PASSWORD=<mot de passe, 8 caractères minimum>
MINIO_BUCKET=media
# URL publique des fichiers (domaine Dokploy -> port 9000 de minio-staging), avec https
MINIO_PUBLIC_URL=https://files-staging.model-technologie.com
# Domaines (sans https://) à déclarer dans Dokploy : API S3 (9000) et console (9001)
MINIO_PUBLIC_DOMAIN=files-staging.model-technologie.com
MINIO_CONSOLE_DOMAIN=minio-staging.model-technologie.com

# ── E-mails transactionnels ──────────────────────────────────────────────────
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=<identifiant SMTP>
MAIL_PASSWORD=<clé SMTP>
MAIL_FROM=noreply@model-technologie.com
# STAGING : toujours renseigner. Tous les e-mails (candidats, apprenants, équipe) sont envoyés à cette
# adresse unique au lieu de leurs destinataires. À NE JAMAIS définir en production.
MAIL_REDIRECT_TO=recette@model-technologie.com

# ── Notifications internes ───────────────────────────────────────────────────
# Boîte de l'équipe qui reçoit les alertes (contact, paiement à confirmer, question d'apprenant)
NOTIFICATION_EMAIL_TO=recette@model-technologie.com
NOTIFICATION_PHONE_TO=
SLACK_WEBHOOK_URL=
SLACK_BOOTCAMP_SUBSCRIPTION_WEBHOOK_URL=
MASTERCLASS_MEET_LINK=

# ── Optionnel ────────────────────────────────────────────────────────────────
# APP_TIMEZONE=Africa/Dakar
# Mentions de facture (défauts = Model Technologie) : APP_INVOICE_SELLER_*, APP_INVOICE_VAT_PERCENT
# Verrouillage : AUTH_LOCKOUT_MAX_ATTEMPTS=5, AUTH_LOCKOUT_MINUTES=15
